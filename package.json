{
  "name": "my-app",
  "version": "2.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "prebuild": "npm run check:guidance",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.spec.json --noEmit",
    "typecheck:cypress": "tsc -p cypress/tsconfig.json --noEmit",
    "check:guidance": "node scripts/check-guidance.mjs",
    "test:feed": "node --test src/writing-feed.test.mjs",
    "test:server": "node --test src/server.test.mjs",
    "test:deployment": "node --test scripts/verify-deployment.test.mjs",
    "test:browser-helper": "node --test tests/service-worker/chrome.test.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs",
    "check:service-worker": "node scripts/check-service-worker.mjs",
    "test:service-worker": "node --test --test-concurrency=1 tests/service-worker/chrome.test.mjs tests/service-worker/fixture-server.test.mjs tests/service-worker/service-worker.test.mjs",
    "serve:ssr:my-app": "node dist/my-app/server/server.mjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@angular/ssr": "^22.2.5",
    "bootstrap": "^5.3.6",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "xml2js": "^0.6.2",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.4",
    "@cypress/schematic": "^3.0.0",
    "@netlify/angular-runtime": "^4.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "cypress": "^15.21.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~6.0.3"
  }
}
